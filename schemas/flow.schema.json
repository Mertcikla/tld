{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Mertcikla/tld/refs/heads/main/schemas/flow.schema.json",
  "title": "Portable tlDiagram flow v1",
  "description": "Portable tlDiagram flow v1. This structural schema describes the portable document shape. The importer is authoritative for contextual references and additional runtime limits: complete UTF-8 YAML bytes, cumulative nested step count and depth, global step/path ID uniqueness, UTF-8 byte lengths (JSON Schema maxLength counts Unicode code points), and connector uniqueness by ordered endpoints plus label. A schema-valid document may still be rejected by the importer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "name",
    "steps"
  ],
  "properties": {
    "format": {
      "const": "tld-flow"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "maxLength": 10000
    },
    "steps": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 10000
        },
        "elements": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "connectors": {
          "type": "array",
          "maxItems": 500,
          "description": "Runtime uniqueness is based on source, target, and label.",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/connector"
          }
        },
        "branches": {
          "$ref": "#/$defs/branches"
        },
        "goToFlow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "view": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "pattern": "\\S"
            }
          }
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "branches",
              "goToFlow"
            ]
          }
        }
      ]
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "target": {
          "type": "string",
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "maxLength": 10000,
          "description": "Optional only when ordered endpoints identify one connector. Empty string explicitly selects an unlabeled connector."
        }
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "paths"
      ],
      "properties": {
        "mode": {
          "enum": [
            "alternate",
            "parallel"
          ]
        },
        "paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 26,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "steps"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "steps": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            }
          }
        }
      }
    }
  }
}
